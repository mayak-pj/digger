{
  "_readme": "Источники интернет-поиска (схема 2). Всё можно менять без программирования. levels — порядок уровней поиска (enabled: вкл/выкл целого уровня). sources — источники: id; adapter — тип адаптера; level — уровень; lang — язык (en, zh, ru; пусто — по запросу); domains — домены, к которым источник обращается (попадают в белый список); queries — свои шаблоны запросов (пусто — общие); enabled — вкл/выкл; needs_key — имя ключа в config.json → acquire.api_keys (без ключа источник пропускается). {part} — партномер, {code} — короткий код маркировки, {maker_site} — сайт производителя, {q} — запрос. Программа обращается только к доменам, перечисленным здесь или в config.json → network.allowed_domains. Шаблоны адресов сайтов проверяйте через меню «Сеть → Диагностика».",
  "version": 2,

  "levels": [
    {"id": "catalog", "name": "1. Сайты-каталоги datasheet", "enabled": true},
    {"id": "maker",   "name": "2. Сайт производителя", "enabled": true},
    {"id": "search",  "name": "Поисковики (английский)", "enabled": true},
    {"id": "world",   "name": "Мировые магазины", "enabled": true},
    {"id": "china",   "name": "3. Китайский интернет", "enabled": true},
    {"id": "russian", "name": "Русский интернет", "enabled": true},
    {"id": "forum",   "name": "4. Форумы инженеров", "enabled": true},
    {"id": "marking", "name": "5. Базы SMD-кодов маркировки", "enabled": true, "for_codes": true},
    {"id": "github",  "name": "6. GitHub (репозитории с документацией)", "enabled": true}
  ],

  "sources": [
    {"id": "alldatasheet", "adapter": "alldatasheet", "name": "AllDatasheet", "level": "catalog", "lang": "en", "url": "https://www.alldatasheet.com/view.jsp?Searchword={part}", "domains": ["alldatasheet.com"], "follow": 1, "enabled": true},
    {"id": "datasheetarchive", "adapter": "datasheetarchive", "name": "Datasheet Archive", "level": "catalog", "lang": "en", "url": "https://www.datasheetarchive.com/search?q={part}", "domains": ["datasheetarchive.com"], "follow": 1, "timeout": 45, "enabled": true},
    {"id": "findchips", "adapter": "findchips", "name": "FindChips", "level": "catalog", "lang": "en", "url": "https://www.findchips.com/search/{part}", "domains": ["findchips.com"], "follow": 0, "enabled": false, "note": "выключен 2026-10-06: на работе страница до 1.7 МБ грузится 16–45 с, режется на 512 КБ, ссылок на PDF в ней нет — только партномера для подсказок"},
    {"id": "datasheet4u", "adapter": "datasheet4u", "name": "Datasheet4U", "level": "catalog", "lang": "en", "url": "https://datasheet4u.com/share_search.php?sWord={part}", "domains": ["datasheet4u.com"], "follow": 1, "enabled": true},
    {"id": "datasheetspdf", "adapter": "datasheet4u", "name": "DatasheetsPDF", "level": "catalog", "lang": "en", "url": "https://www.datasheetspdf.com/share_search.php?sWord={part}", "domains": ["datasheetspdf.com"], "follow": 1, "enabled": false},
    {"id": "catalog_queries", "adapter": "engine_queries", "name": "Каталоги через поисковики", "level": "catalog", "lang": "en", "enabled": true,
     "via": ["duckduckgo", "bing", "mojeek", "brave"],
     "queries": [
       "{part} datasheet pdf",
       "{part} datasheet site:alldatasheet.com OR site:datasheetspdf.com OR site:datasheet4u.com OR site:datasheetarchive.com",
       "{part} pdf site:datasheet.lcsc.com OR site:mouser.com OR site:digikey.com OR site:farnell.com"
     ]},

    {"id": "maker_ti", "adapter": "maker_url", "name": "Texas Instruments", "level": "maker", "lang": "en", "domains": ["ti.com"], "prefixes": ["^(SN|TL|LM|TPS|MSP|CC\\d|OPA|ADS|LP|UCC|TMP|INA|DRV|BQ|TLV|TCA|PCA|CD4|TXB|TXS|THS|REF|DAC|ISO)"], "urls": ["https://www.ti.com/lit/ds/symlink/{part_lower}.pdf"], "enabled": true},
    {"id": "maker_st", "adapter": "maker_url", "name": "STMicroelectronics", "level": "maker", "lang": "en", "domains": ["st.com"], "prefixes": ["^(STM32|STM8|STM\\d|STP|STF|L78|L79|LD\\d|LM[23]\\d\\d|M24|M95|M25|ST\\d|VN|VL|TS\\d|LIS|LSM)"], "urls": ["https://www.st.com/resource/en/datasheet/{part_lower}.pdf"], "enabled": true},
    {"id": "maker_microchip", "adapter": "maker_url", "name": "Microchip", "level": "maker", "lang": "en", "domains": ["microchip.com"], "prefixes": ["^(PIC|DSPIC|ATMEGA|ATTINY|ATXMEGA|AT\\d|SST\\d|24[A-Z]{1,3}\\d|25[A-Z]{1,3}\\d|93[A-Z]{1,3}\\d|MCP|MIC|ATSAM)"], "urls": ["https://ww1.microchip.com/downloads/en/DeviceDoc/{part}.pdf", "https://ww1.microchip.com/downloads/en/DeviceDoc/{part_lower}.pdf"], "enabled": true},
    {"id": "maker_espressif", "adapter": "maker_url", "name": "Espressif", "level": "maker", "lang": "en", "domains": ["espressif.com"], "prefixes": ["^ESP"], "urls": ["https://www.espressif.com/sites/default/files/documentation/{part_lower}_datasheet_en.pdf"], "enabled": true},
    {"id": "maker_winbond", "adapter": "maker_url", "name": "Winbond", "level": "maker", "lang": "en", "domains": ["winbond.com"], "prefixes": ["^W(25|29|74|9[0-9])"], "urls": ["https://www.winbond.com/resource-files/{part}.pdf"], "enabled": true},
    {"id": "maker_macronix", "adapter": "maker_url", "name": "Macronix", "level": "maker", "lang": "en", "domains": ["macronix.com"], "prefixes": ["^MX(25|29|30)"], "urls": ["https://www.macronix.com/Lists/Datasheet/Attachments/{part}.pdf"], "enabled": true},
    {"id": "maker_wch", "adapter": "maker_url", "name": "WCH", "level": "maker", "lang": "en", "domains": ["wch-ic.com"], "prefixes": ["^CH\\d"], "page_urls": ["https://www.wch-ic.com/products/{part}.html"], "enabled": true},
    {"id": "maker_queries", "adapter": "engine_queries", "name": "Сайт производителя через поисковики", "level": "maker", "lang": "en", "enabled": true,
     "via": ["duckduckgo", "bing", "mojeek"],
     "queries": ["{part} datasheet site:{maker_site}"]},

    {"id": "google", "adapter": "google_api", "name": "Google", "level": "search", "lang": "en", "url": "https://www.googleapis.com/customsearch/v1?key={key}&cx={cx}&q={q}", "domains": ["googleapis.com"], "needs_key": "google_api", "enabled": true},
    {"id": "duckduckgo", "adapter": "engine_html", "name": "DuckDuckGo", "level": "search", "lang": "en", "url": "https://html.duckduckgo.com/html/?q={q}", "decoder": "ddg", "domains": ["duckduckgo.com"], "enabled": true},
    {"id": "bing", "adapter": "engine_html", "name": "Bing", "level": "search", "lang": "en", "url": "https://www.bing.com/search?q={q}&setlang=en", "decoder": "bing", "domains": ["bing.com"], "enabled": true},
    {"id": "mojeek", "adapter": "engine_html", "name": "Mojeek", "level": "search", "lang": "en", "url": "https://www.mojeek.com/search?q={q}", "decoder": "mojeek", "domains": ["mojeek.com"], "enabled": true},
    {"id": "brave", "adapter": "engine_html", "name": "Brave Search", "level": "search", "lang": "en", "url": "https://search.brave.com/search?q={q}", "decoder": "brave", "domains": ["search.brave.com"], "enabled": true},

    {"id": "lcsc", "adapter": "direct_url", "name": "立创商城 LCSC", "level": "china", "lang": "zh", "label": "立创商城 szlcsc.com", "url": "https://so.szlcsc.com/global.html?k={part}", "domains": ["szlcsc.com", "lcsc.com"], "follow": 1, "enabled": true},
    {"id": "semiee", "adapter": "direct_url", "name": "半导小芯 Semiee", "level": "china", "lang": "zh", "label": "半导小芯 semiee.com", "url": "https://www.semiee.com/search?searchModel={part}", "domains": ["semiee.com"], "follow": 1, "enabled": true},
    {"id": "baidu", "adapter": "engine_html", "name": "百度", "level": "china", "lang": "zh", "url": "https://www.baidu.com/s?wd={q}", "decoder": "baidu", "domains": ["baidu.com"], "enabled": true},
    {"id": "bing_cn", "adapter": "engine_html", "name": "必应", "level": "china", "lang": "zh", "url": "https://www.bing.com/search?q={q}&setlang=zh-Hans", "decoder": "bing", "domains": ["bing.com"], "enabled": false, "note": "выключен 2026-10-06: cn.bing.com переадресует на главную без выдачи, www.bing.com с mkt=zh-CN отвечает «нет результатов», а без mkt повторяет выдачу источника bing"},
    {"id": "sogou", "adapter": "engine_html", "name": "搜狗", "level": "china", "lang": "zh", "url": "https://www.sogou.com/web?query={q}", "decoder": "sogou", "domains": ["sogou.com"], "enabled": true},
    {"id": "so360", "adapter": "engine_html", "name": "360搜索", "level": "china", "lang": "zh", "url": "https://www.so.com/s?q={q}", "decoder": "so360", "domains": ["so.com"], "enabled": true},
    {"id": "china_queries", "adapter": "engine_queries", "name": "Китайские сайты через поисковики", "level": "china", "lang": "zh", "enabled": true,
     "via": ["baidu", "bing_cn", "sogou", "so360"],
     "queries": [
       "{part} 数据手册 pdf",
       "{part} 规格书",
       "{part} datasheet site:elecfans.com OR site:21ic.com OR site:dzsc.com OR site:semiee.com",
       "{part} site:eeworld.com.cn OR site:51hei.com OR site:amobbs.com OR site:icpdf.com",
       "{part} site:aliexpress.com OR site:aliexpress.ru",
       "{part} 芯片 site:taobao.com OR site:tmall.com OR site:item.taobao.com",
       "{part} 现货 site:1688.com OR site:detail.1688.com"
     ]},

    {"id": "yandex", "adapter": "engine_html", "name": "Яндекс", "level": "russian", "lang": "ru", "url": "https://yandex.ru/search/?text={q}", "decoder": "yandex", "domains": ["yandex.ru"], "enabled": true},

    {"id": "chipdip", "adapter": "direct_url", "name": "Чип и Дип", "level": "russian", "lang": "ru", "label": "Чип и Дип chipdip.ru", "url": "https://www.chipdip.ru/search?searchtext={part}", "domains": ["chipdip.ru", "static.chipdip.ru"], "follow": 1, "enabled": true},
    {"id": "russian_queries", "adapter": "engine_queries", "name": "Российские магазины через поисковики", "level": "russian", "lang": "ru", "enabled": true,
     "via": ["yandex", "duckduckgo", "bing"],
     "queries": [
       "{part} даташит pdf",
       "{part} site:promelec.ru OR site:efo.ru OR site:compel.ru OR site:elitan.ru",
       "{part} купить site:ozon.ru"
     ]},
    {"id": "mouser_api", "adapter": "mouser_api", "name": "Mouser API", "level": "world", "lang": "en", "label": "Mouser", "url": "https://api.mouser.com/api/v1/search/partnumber?apiKey={key}", "domains": ["api.mouser.com"], "needs_key": "mouser", "enabled": true},
    {"id": "digikey_api", "adapter": "digikey_api", "name": "DigiKey API", "level": "world", "lang": "en", "label": "DigiKey", "url": "https://api.digikey.com/products/v4/search/keyword", "token_url": "https://api.digikey.com/v1/oauth2/token", "domains": ["api.digikey.com"], "needs_key": "digikey", "enabled": true},
    {"id": "world_queries", "adapter": "engine_queries", "name": "Мировые магазины через поисковики", "level": "world", "lang": "en", "enabled": true,
     "via": ["duckduckgo", "bing", "brave"],
     "queries": [
       "{part} datasheet site:mouser.com OR site:digikey.com",
       "{part} datasheet site:farnell.com OR site:arrow.com OR site:newark.com",
       "{part} site:ebay.com"
     ]},
    {"id": "forum_queries", "adapter": "engine_queries", "name": "Форумы через поисковики", "level": "forum", "lang": "", "enabled": true,
     "via": ["duckduckgo", "bing", "yandex"],
     "queries": [
       "{part} site:eevblog.com OR site:electronics.stackexchange.com OR site:badcaps.net OR site:reddit.com",
       "{part} datasheet site:electronix.ru OR site:radiokot.ru OR site:forum.cxem.net OR site:kazus.ru OR site:vrtp.ru",
       "{part} даташит"
     ]},

    {"id": "marking_queries", "adapter": "engine_queries", "name": "Коды маркировки через поисковики", "level": "marking", "lang": "", "enabled": true,
     "via": ["duckduckgo", "bing", "baidu", "yandex"],
     "queries": [
       "\"{code}\" SMD marking code",
       "{code} 丝印 芯片",
       "{code} маркировка SMD",
       "{code} site:s-manuals.com OR site:alltransistors.com OR site:smd.yooneed.one"
     ]},

    {"id": "github", "adapter": "github_api", "name": "GitHub", "level": "github", "lang": "en", "url": "https://api.github.com/search/repositories?q={part}+in:name,description,readme&per_page=10", "domains": ["api.github.com", "github.com", "raw.githubusercontent.com"], "enabled": true}
  ],

