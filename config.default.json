{
  "_readme": "Настройки по умолчанию. НЕ редактируйте этот файл — свои изменения пишите в config.json (его создаёт окно «Настройки»). Там достаточно указать только изменённые параметры.",

  "modules": {
    "enhancer":   "digger.modules.enhance_opencv:OpenCVEnhancer",
    "ocr":        "digger.recognition.manager:RecognitionManager",
    "identifier": "digger.modules.identify_rules:RuleIdentifier",
    "local_db":   "digger.modules.localdb_sqlite:SQLiteLocalDB",
    "web_search": "digger.acquire.websearch:AcquireWebSearch",
    "pdf_text":   "digger.modules.pdftext_pypdf:PyPdfText",
    "comparator": "digger.modules.compare_basic:BasicComparator",
    "memory":     "digger.modules.memory_rules:RuleMemoryAnalyzer",
    "report":     "digger.modules.report_html:HtmlReport"
  },

  "paths": {
    "db": "data/digger.sqlite",
    "library_dir": "data/library",
    "quarantine_dir": "data/quarantine",
    "log_dir": "logs",
    "reports_dir": "reports",
    "scan_roots": []
  },

  "module_settings": {
    "enhancer":   {"target_height": 500, "max_upscale": 5.0, "deskew": true},
    "ocr":        {"tesseract_cmd": "", "lang": "eng", "psm_modes": [6, 11], "rotations": [0, 90, 180, 270], "min_line_conf": 30},
    "identifier": {"max_candidates": 12, "check_local_db": true},
    "local_db":   {},
    "web_search": {"max_parts": 2, "max_hits": 60, "quarantine_keep_days": 7},
    "pdf_text":   {"max_pages": 40},
    "comparator": {},
    "memory":     {},
    "report":     {}
  },

  "recognition": {
    "mode": "auto",
    "chain": ["ppocr", "tesseract"],
    "auto": {"min_confidence": 60, "require_confirmed": false},
    "cloud_enabled": false,
    "providers": {
      "ppocr": {"text_score": 0.3, "det_box_thresh": 0.3, "det_unclip_ratio": 1.8, "rotations": [0, 90, 180, 270]},
      "tesseract": {}
    }
  },

  "pipeline": {
    "local_accept_score": 0.8,
    "auto_web_search": false,
    "auto_download": true,
    "auto_download_count": 3
  },

  "network": {
    "offline": false,
    "proxy": "",
    "use_system_proxy": true,
    "timeout_sec": 15,
    "min_interval_sec": 1.5,
    "max_html_mb": 3,
    "max_pdf_mb": 40,
    "allowed_domains": [],
    "allow_http": [],
    "blocked_domains": []
  },

  "acquire": {
    "api_keys": {"google_api": {"key": "", "cx": ""}, "mouser": {"key": ""},
                 "digikey": {"client_id": "", "client_secret": ""}},
    "budget": {"queries": 60, "downloads": 10, "seconds": 180},
    "languages": ["en", "zh", "ru"],
    "parallel": 3,
    "adaptive": {"enabled": true, "min_searches": 20, "explore": 0.1},
    "weights": {
      "E1_front": 30, "E1_any": 20, "E2": 15, "E3": 15, "E4": 10,
      "E5": {"datasheet": 15, "family": 15, "app_note": -20, "errata": -20, "reference_manual": -20, "catalog": -20,
             "distributor_page": -30},
      "E6_match": 10, "E6_conflict": -15, "E7_match": 10, "E7_conflict": -10, "E8": 10,
      "E9_maker": 10, "E9_catalog": 5, "E9_bad": -10, "E10": 10, "E11": -30
    },
    "thresholds": {"confirmed": 70, "probable": 45},
    "scan_ocr": {"enabled": true, "lang": "eng", "head_pages": 4, "tail_pages": 2, "page_seconds": 30,
                 "total_seconds": 60}
  },

  "ui": {"theme": "light", "follow_recognition": true},

  "extensions": {"enabled": [], "disabled": [], "settings": {}}
}
